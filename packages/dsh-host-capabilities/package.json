{
  "name": "@dsh-one/dsh-host-capabilities",
  "version": "0.1.0",
  "description": "Host half of dsh-one's plugin capabilities: persistent state under ~/.dsh, read-only git, and file writes for plugins that must also run on official dsh web.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.6-alpha.1",
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
