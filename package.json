{
  "name": "dsh-one",
  "displayName": "DSH One",
  "description": "dsh 与 VSCode 的桥接插件：定位本机已安装的 dsh，从 VSCode 直接启动或复用 dsh web 服务，并内嵌界面、同步 workspace。",
  "version": "0.1.0",
  "publisher": "dsh-one",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/imchangchang/dsh-one.git"
  },
  "bugs": {
    "url": "https://github.com/imchangchang/dsh-one/issues"
  },
  "homepage": "https://github.com/imchangchang/dsh-one",
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dshOne.open",
        "title": "打开面板",
        "category": "DSH One"
      },
      {
        "command": "dshOne.openInTab",
        "title": "在编辑器标签页打开",
        "category": "DSH One"
      },
      {
        "command": "dshOne.restart",
        "title": "重启服务",
        "category": "DSH One"
      },
      {
        "command": "dshOne.stop",
        "title": "停止服务",
        "category": "DSH One"
      },
      {
        "command": "dshOne.showLogs",
        "title": "显示日志",
        "category": "DSH One"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-one",
          "title": "DSH One",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "dsh-one": [
        {
          "id": "dshOne.sidebar",
          "name": "DSH",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "DSH One",
      "properties": {
        "dshOne.dshPath": {
          "type": "string",
          "default": "",
          "description": "dsh 可执行文件路径。留空则从 PATH 查找。"
        },
        "dshOne.port": {
          "type": "number",
          "default": 3080,
          "minimum": 0,
          "description": "dsh web 服务端口。0 表示由操作系统分配；非 0 时会先探测该端口上是否已有 dsh 实例并复用之。注意 0 会让 dsh UI 的会话恢复失效（localStorage 按 origin 隔离）。"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
