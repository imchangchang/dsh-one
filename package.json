{
  "name": "dsh-one",
  "displayName": "DSH One",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "cgeng",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/imchangchang/dsh-one.git"
  },
  "bugs": {
    "url": "https://github.com/imchangchang/dsh-one/issues"
  },
  "homepage": "https://github.com/imchangchang/dsh-one",
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "icons": {
      "dsh-fish": {
        "description": "%icon.dshFish.description%",
        "default": {
          "fontPath": "assets/dsh-icon.woff",
          "fontCharacter": "\\f101"
        }
      }
    },
    "commands": [
      {
        "command": "dshOne.open",
        "title": "%dshOne.open.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.openExternal",
        "title": "%dshOne.openExternal.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.openInTab",
        "title": "%dshOne.openInTab.title%",
        "category": "DSH One",
        "icon": "$(globe)"
      },
      {
        "command": "dshOne.restart",
        "title": "%dshOne.restart.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.stop",
        "title": "%dshOne.stop.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.showLogs",
        "title": "%dshOne.showLogs.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.sessions.refresh",
        "title": "%dshOne.sessions.refresh.title%",
        "category": "DSH One",
        "icon": "$(refresh)"
      },
      {
        "command": "dshOne.session.new",
        "title": "%dshOne.session.new.title%",
        "category": "DSH One",
        "icon": "$(add)"
      },
      {
        "command": "dshOne.workspace.add",
        "title": "%dshOne.workspace.add.title%",
        "category": "DSH One",
        "icon": "$(add)"
      },
      {
        "command": "dshOne.workspace.create",
        "title": "%dshOne.workspace.create.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.openInstallPage",
        "title": "%dshOne.openInstallPage.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.rename",
        "title": "%dshOne.session.rename.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.archive",
        "title": "%dshOne.session.archive.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.fork",
        "title": "%dshOne.session.fork.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.attachFile",
        "title": "%dshOne.session.attachFile.title%"
      },
      {
        "command": "dshOne.workspace.openFolder",
        "title": "%dshOne.workspace.openFolder.title%",
        "category": "DSH One"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dshOne.session.attachFile",
          "when": "editorIsOpen",
          "group": "2_dshOne@1"
        }
      ],
      "explorer/context": [
        {
          "command": "dshOne.session.attachFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "2_dshOne@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-one",
          "title": "DSH One",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "dsh-one": [
        {
          "id": "dshOne.chat",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "DSH One",
      "properties": {
        "dshOne.dshPath": {
          "type": "string",
          "default": "",
          "description": "%dshOne.dshPath.description%"
        },
        "dshOne.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%dshOne.autoStart.description%"
        },
        "dshOne.port": {
          "type": "number",
          "default": 3080,
          "minimum": 0,
          "description": "%dshOne.port.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "marked": "^18.0.11"
  }
}
