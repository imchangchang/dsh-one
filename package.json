{
  "name": "dsh-one",
  "displayName": "DSH One",
  "description": "dsh 与 VSCode 的桥接插件：定位本机已安装的 dsh，从 VSCode 直接启动或复用 dsh web 服务，并内嵌界面、同步 workspace。",
  "version": "0.1.0",
  "publisher": "cgeng",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/imchangchang/dsh-one.git"
  },
  "bugs": {
    "url": "https://github.com/imchangchang/dsh-one/issues"
  },
  "homepage": "https://github.com/imchangchang/dsh-one",
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "icons": {
      "dsh-fish": {
        "description": "dsh 像素鱼图标",
        "default": {
          "fontPath": "assets/dsh-icon.woff",
          "fontCharacter": "\\f101"
        }
      }
    },
    "commands": [
      {
        "command": "dshOne.open",
        "title": "打开面板",
        "category": "DSH One"
      },
      {
        "command": "dshOne.openExternal",
        "title": "在浏览器中打开 dsh 页面",
        "category": "DSH One"
      },
      {
        "command": "dshOne.openInTab",
        "title": "打开 dsh 页面",
        "category": "DSH One",
        "icon": "$(globe)"
      },
      {
        "command": "dshOne.restart",
        "title": "重启服务",
        "category": "DSH One"
      },
      {
        "command": "dshOne.stop",
        "title": "停止服务",
        "category": "DSH One"
      },
      {
        "command": "dshOne.showLogs",
        "title": "显示日志",
        "category": "DSH One"
      },
      {
        "command": "dshOne.sessions.refresh",
        "title": "刷新会话列表",
        "category": "DSH One",
        "icon": "$(refresh)"
      },
      {
        "command": "dshOne.session.new",
        "title": "新建会话",
        "category": "DSH One",
        "icon": "$(add)"
      },
      {
        "command": "dshOne.workspace.add",
        "title": "新建 workspace",
        "category": "DSH One",
        "icon": "$(add)"
      },
      {
        "command": "dshOne.workspace.create",
        "title": "创建工作区",
        "category": "DSH One"
      },
      {
        "command": "dshOne.openInstallPage",
        "title": "查看 dsh 安装指南",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.rename",
        "title": "重命名会话",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.archive",
        "title": "归档会话",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.fork",
        "title": "分叉会话",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.attachFile",
        "title": "DSH One: 发送到当前会话"
      },
      {
        "command": "dshOne.workspace.openFolder",
        "title": "在 VSCode 中打开文件夹",
        "category": "DSH One"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dshOne.session.attachFile",
          "when": "editorIsOpen",
          "group": "2_dshOne@1"
        }
      ],
      "explorer/context": [
        {
          "command": "dshOne.session.attachFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "2_dshOne@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-one",
          "title": "DSH One",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "dsh-one": [
        {
          "id": "dshOne.chat",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "DSH One",
      "properties": {
        "dshOne.dshPath": {
          "type": "string",
          "default": "",
          "description": "dsh 可执行文件路径。留空则从 PATH 查找。"
        },
        "dshOne.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "激活扩展时自动启动（或复用）dsh web 服务。"
        },
        "dshOne.port": {
          "type": "number",
          "default": 3080,
          "minimum": 0,
          "description": "dsh web 服务端口。0 表示由操作系统分配；非 0 时会先探测该端口上是否已有 dsh 实例并复用之。注意 0 会让 dsh UI 的会话恢复失效（localStorage 按 origin 隔离）。"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "marked": "^18.0.11"
  }
}
