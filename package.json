{
  "name": "dsh-one",
  "displayName": "DSH One",
  "description": "%extension.description%",
  "version": "2.0.6",
  "publisher": "cgeng",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/imchangchang/dsh-one.git"
  },
  "bugs": {
    "url": "https://github.com/imchangchang/dsh-one/issues"
  },
  "homepage": "https://github.com/imchangchang/dsh-one",
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:dshOne.assembledChat"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "workspaces": [
    "packages/*"
  ],
  "contributes": {
    "icons": {
      "dsh-fish": {
        "description": "%icon.dshFish.description%",
        "default": {
          "fontPath": "assets/dsh-icon.woff",
          "fontCharacter": "\\f101"
        }
      }
    },
    "commands": [
      {
        "command": "dshOne.openExternal",
        "title": "%dshOne.openExternal.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.start",
        "title": "%dshOne.start.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.assembledChat",
        "title": "%dshOne.assembledChat.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.assembledSettings",
        "title": "%dshOne.assembledSettings.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.assembledPlugins",
        "title": "%dshOne.assembledPlugins.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.restart",
        "title": "%dshOne.restart.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.stop",
        "title": "%dshOne.stop.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.external.pasteToken",
        "title": "%dshOne.external.pasteToken.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.external.copyTokenTemplate",
        "title": "%dshOne.external.copyTokenTemplate.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.external.stop",
        "title": "%dshOne.external.stop.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.external.restart",
        "title": "%dshOne.external.restart.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.statusPanel",
        "title": "%dshOne.statusPanel.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.showLogs",
        "title": "%dshOne.showLogs.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.copyLink",
        "title": "%dshOne.copyLink.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.copyLanLink",
        "title": "%dshOne.copyLanLink.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.restartLan",
        "title": "%dshOne.restartLan.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.restartLocal",
        "title": "%dshOne.restartLocal.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.checkUpdate",
        "title": "%dshOne.checkUpdate.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.upgrade",
        "title": "%dshOne.upgrade.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.new",
        "title": "%dshOne.session.new.title%",
        "category": "DSH One",
        "icon": "$(add)"
      },
      {
        "command": "dshOne.workspace.add",
        "title": "%dshOne.workspace.add.title%",
        "category": "DSH One",
        "icon": "$(add)"
      },
      {
        "command": "dshOne.workspace.create",
        "title": "%dshOne.workspace.create.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.openInstallPage",
        "title": "%dshOne.openInstallPage.title%",
        "category": "DSH One"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-one",
          "title": "DSH One",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "dsh-one": [
        {
          "id": "dshOne.chat",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "DSH One",
      "properties": {
        "dshOne.dshPath": {
          "type": "string",
          "default": "",
          "description": "%dshOne.dshPath.description%"
        },
        "dshOne.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%dshOne.autoStart.description%"
        },
        "dshOne.port": {
          "type": "number",
          "default": 3080,
          "minimum": 0,
          "description": "%dshOne.port.description%"
        },
        "dshOne.lanAccess": {
          "type": "boolean",
          "default": false,
          "description": "%dshOne.lanAccess.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.ts test/mock-dsh/*.test.ts test/mock-llm/*.test.ts",
    "verify:host-half": "npm run build && node scripts/verify-host-half-official.mjs",
    "verify:plugins-official": "npm run build && node scripts/verify-plugins-official.mjs",
    "verify:clean-profile": "npm run build && node scripts/verify-clean-profile.mjs",
    "verify:lab": "npm run build && node test/assembly-lab/verify.ts",
    "verify:lab-version": "node scripts/verify-lab-version.mjs",
    "package": "npm run build && vsce package",
    "verify:install-guide": "node --import ./test/install-guide/register.mjs test/install-guide/smoke.mjs",
    "verify:legacy-sidebar": "npm run build && node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./test/legacy-sidebar/register.mjs test/legacy-sidebar/verify.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2"
  }
}
