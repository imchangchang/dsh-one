{
  "name": "dsh-one",
  "displayName": "DSH One",
  "description": "%extension.description%",
  "version": "1.2.0",
  "publisher": "cgeng",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/imchangchang/dsh-one.git"
  },
  "bugs": {
    "url": "https://github.com/imchangchang/dsh-one/issues"
  },
  "homepage": "https://github.com/imchangchang/dsh-one",
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "icons": {
      "dsh-fish": {
        "description": "%icon.dshFish.description%",
        "default": {
          "fontPath": "assets/dsh-icon.woff",
          "fontCharacter": "\\f101"
        }
      }
    },
    "commands": [
      {
        "command": "dshOne.open",
        "title": "%dshOne.open.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.openExternal",
        "title": "%dshOne.openExternal.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.start",
        "title": "%dshOne.start.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.openInTab",
        "title": "%dshOne.openInTab.title%",
        "category": "DSH One",
        "icon": "$(globe)"
      },
      {
        "command": "dshOne.restart",
        "title": "%dshOne.restart.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.stop",
        "title": "%dshOne.stop.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.external.pasteToken",
        "title": "%dshOne.external.pasteToken.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.external.copyTokenTemplate",
        "title": "%dshOne.external.copyTokenTemplate.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.external.stop",
        "title": "%dshOne.external.stop.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.external.restart",
        "title": "%dshOne.external.restart.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.showLogs",
        "title": "%dshOne.showLogs.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.sessions.refresh",
        "title": "%dshOne.sessions.refresh.title%",
        "category": "DSH One",
        "icon": "$(refresh)"
      },
      {
        "command": "dshOne.session.new",
        "title": "%dshOne.session.new.title%",
        "category": "DSH One",
        "icon": "$(add)"
      },
      {
        "command": "dshOne.workspace.add",
        "title": "%dshOne.workspace.add.title%",
        "category": "DSH One",
        "icon": "$(add)"
      },
      {
        "command": "dshOne.workspace.create",
        "title": "%dshOne.workspace.create.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.openInstallPage",
        "title": "%dshOne.openInstallPage.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.rename",
        "title": "%dshOne.session.rename.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.archive",
        "title": "%dshOne.session.archive.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.fork",
        "title": "%dshOne.session.fork.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.copyReference",
        "title": "%dshOne.session.copyReference.title%",
        "category": "DSH One"
      },
      {
        "command": "dshOne.session.attachFile",
        "title": "%dshOne.session.attachFile.title%"
      },
      {
        "command": "dshOne.workspace.openFolder",
        "title": "%dshOne.workspace.openFolder.title%",
        "category": "DSH One"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dshOne.session.attachFile",
          "when": "editorIsOpen",
          "group": "2_dshOne@1"
        }
      ],
      "explorer/context": [
        {
          "command": "dshOne.session.attachFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "2_dshOne@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "dshOne.session.rename",
          "when": "resourceScheme == webview-panel && resourcePath =~ /^webview-panel\\/webview-dshOne\\.chatPanel-/",
          "group": "2_dshOne@1"
        },
        {
          "command": "dshOne.session.fork",
          "when": "resourceScheme == webview-panel && resourcePath =~ /^webview-panel\\/webview-dshOne\\.chatPanel-/",
          "group": "2_dshOne@1"
        },
        {
          "command": "dshOne.session.copyReference",
          "when": "resourceScheme == webview-panel && resourcePath =~ /^webview-panel\\/webview-dshOne\\.chatPanel-/",
          "group": "2_dshOne@1"
        },
        {
          "command": "dshOne.session.archive",
          "when": "resourceScheme == webview-panel && resourcePath =~ /^webview-panel\\/webview-dshOne\\.chatPanel-/",
          "group": "2_dshOne@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-one",
          "title": "DSH One",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "dsh-one": [
        {
          "id": "dshOne.chat",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "DSH One",
      "properties": {
        "dshOne.dshPath": {
          "type": "string",
          "default": "",
          "description": "%dshOne.dshPath.description%"
        },
        "dshOne.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%dshOne.autoStart.description%"
        },
        "dshOne.port": {
          "type": "number",
          "default": 3080,
          "minimum": 0,
          "description": "%dshOne.port.description%"
        },
        "dshOne.chatFontSize": {
          "type": "number",
          "default": 14,
          "minimum": 12,
          "maximum": 17,
          "description": "%dshOne.chatFontSize.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts test/mock-dsh/*.test.ts test/mock-llm/*.test.ts",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-modules": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-approval": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-user-questions": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-rc.1",
    "@deepseek-ai/dsh-web-frontend": "0.1.2-rc.1",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "marked": "^18.0.11"
  }
}
